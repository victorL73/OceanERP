{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=oceanerp;Username=oceanerp;Password=oceanerp"
  },
  "Jwt": {
    "Issuer": "OceanERP",
    "Audience": "OceanERP",
    "SigningKey": "CHANGE_ME_OCEANERP_DEVELOPMENT_KEY_32_CHARS_MINIMUM",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Storage": {
    "RootPath": "storage"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Seed": {
    "AdminEmail": "admin@oceanerp.local",
    "AdminPassword": "ChangeMe!12345"
  },
  "Email": {
    "EnableSmtpSending": false
  },
  "Secrets": {
    "EncryptionKey": "CHANGE_ME_OCEANERP_SECRET_ENCRYPTION_KEY_32_CHARS_MINIMUM"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
