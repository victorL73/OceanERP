PUBLIC_URL=https://erp.example.com
HTTP_PORT=8080
POSTGRES_DB=oceanerp
POSTGRES_USER=oceanerp
POSTGRES_PASSWORD=change-this-postgres-password
JWT_ISSUER=OceanERP
JWT_AUDIENCE=OceanERP
JWT_SIGNING_KEY=change-this-with-a-random-64-character-secret-before-production
SECRETS_ENCRYPTION_KEY=change-this-with-another-random-64-character-secret-for-encrypted-api-keys
ERP_ADMIN_EMAIL=admin@oceanerp.local
ERP_ADMIN_PASSWORD=ChangeMe!12345
ONLYOFFICE_JWT_SECRET=change-this-onlyoffice-secret
ONLYOFFICE_DOCUMENT_SERVER_URL=/onlyoffice
ONLYOFFICE_INTERNAL_BASE_URL=http://nginx
EMAIL_ENABLE_SMTP_SENDING=false
PRESTASHOP_AUTO_SYNC_ENABLED=true
PRESTASHOP_AUTO_SYNC_INTERVAL_SECONDS=10
# Exemple si un compte mail utilise PasswordSecretName=SMTP_MAIN_PASSWORD :
# SMTP_MAIN_PASSWORD=change-this-smtp-password
BACKUP_RETENTION_DAYS=14
BACKUP_ROOT=/opt/oceanerp/backups
BACKUP_COMMAND_TIMEOUT_SECONDS=900
