PUBLIC_URL=https://erp.example.com
HTTP_PORT=8080
POSTGRES_DB=oceanerp
POSTGRES_USER=oceanerp
POSTGRES_PASSWORD=change-this-postgres-password
JWT_ISSUER=OceanERP
JWT_AUDIENCE=OceanERP
JWT_SIGNING_KEY=change-this-with-a-random-64-character-secret-before-production
SECRETS_ENCRYPTION_KEY=change-this-with-another-random-64-character-secret-for-encrypted-api-keys
ERP_ADMIN_EMAIL=admin@oceanerp.local
ERP_ADMIN_PASSWORD=ChangeMe!12345
ONLYOFFICE_JWT_SECRET=change-this-onlyoffice-secret
ONLYOFFICE_DOCUMENT_SERVER_URL=/onlyoffice
EMAIL_ENABLE_SMTP_SENDING=false
# Optionnel : URL/API exposee par le module Colissimo pour recuperer l'etiquette officielle.
# Variables disponibles : {shopUrl}, {apiBaseUrl}, {orderId}, {externalOrderId}, {orderReference}, {orderNumber}
# Plusieurs URLs peuvent etre separees par un point-virgule.
# PRESTASHOP_COLISSIMO_LABEL_ENDPOINT_TEMPLATE=https://boutique.example.com/modules/colissimo/label.php?id_order={orderId}
# Option recommande si le Webservice PrestaShop n'expose pas les etiquettes Colissimo :
# installer deploy/prestashop/oceanerpbridge dans PrestaShop, puis mettre le meme token ici et dans le module.
# PRESTASHOP_COLISSIMO_BRIDGE_TOKEN=change-this-with-a-long-random-token
# Exemple si un compte mail utilise PasswordSecretName=SMTP_MAIN_PASSWORD :
# SMTP_MAIN_PASSWORD=change-this-smtp-password
BACKUP_RETENTION_DAYS=14
