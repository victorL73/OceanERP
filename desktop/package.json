{
  "name": "oceanerp-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OceanERP Windows desktop shell",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "set PATH=C:\\Program Files\\nodejs;%PATH%&& electron-builder --config ../deploy/windows/electron-builder.yml",
    "dist:win": "set PATH=C:\\Program Files\\nodejs;%PATH%&& electron-builder --win nsis --config ../deploy/windows/electron-builder.yml"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12"
  }
}
